grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Так что Стенли, попытайся поиграться с настройками, может постарайся добавить новые механики и сделать игру более интересной"
visible_characters = 0
visible_ratio = 0.0

