grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Ну что, у тебя уже есть практически полноценная игра, не прекрасно ли это?"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase7" unique_id=2125609829]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Но все же кое-что в нахей игре до сих пор, а именно баланса"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel5" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase7" unique_id=449757539]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
