[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase1" unique_id=85305838]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "...О! Вот ты и здесь"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase1" unique_id=118790935]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Ну что, вот мы и попали в игровой движок. Но к сожалению, тут пока-что ничего нет."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase1" unique_id=717954949]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Для начала стоит добавить самого персонажа. Пока что у нас нет тескстур, так что выбирать будем... из обычных примитивов. Сделай выбор, Стенли!"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase2" type="Control" parent="CanvasLayer/Dialogs" unique_id=1243622576]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=1355777164]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Отлично! Теперь мы видим нашего персонажа. Но к сожалению мы пока не может ходить."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=698052085]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "А ведь ходьба - это обязательный элемент для изучения этого безграничного игрового мира."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=786036603]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Давай Стенли, реализуй механику ходьбы! Примени знания из курса Сомана Ракутина на практике!"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase3" type="Control" parent="CanvasLayer/Dialogs" unique_id=1228677138]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=1258740607]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "У нас уже что-то полуается! Ноо, нажестся, чего-то не хватает. Не находишь ли ты, Стенли, ту вещь, чсто наш мир довольно пуст? Ни зданий, ни предметов, вообще ничего!"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=75166894]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "И какой олух захочет играть в игру, где в мире нет никого, кроме тебя любимого? Надо это исправить"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=1690535127]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Подумай Стенли, каким бы ты хотел видеть этот мир?"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase4" type="Control" parent="CanvasLayer/Dialogs" unique_id=1599477361]
layout_mode = 1
