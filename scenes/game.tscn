theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "...О! Вот ты и здесь"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase1" unique_id=118790935]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Ну что, вот мы и попали в игровой движок. Но к сожалению, тут пока-что ничего нет."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase1" unique_id=717954949]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Для начала стоит добавить самого персонажа. Пока что у нас нет тескстур, так что выбирать будем... из обычных примитивов. Сделай выбор, Стенли!"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase2" type="Control" parent="CanvasLayer/Dialogs" unique_id=1243622576]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=1355777164]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Отлично! Теперь мы видим нашего персонажа. Но к сожалению мы пока не может ходить."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=698052085]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "А ведь ходьба - это обязательный элемент для изучения этого безграничного игрового мира."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase2" unique_id=786036603]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Давай Стенли, реализуй механику ходьбы! Примени знания из курса Сомана Ракутина на практике!"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase3" type="Control" parent="CanvasLayer/Dialogs" unique_id=1228677138]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=1258740607]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "У нас уже что-то полуается! Ноо, нажестся, чего-то не хватает. Не находишь ли ты, Стенли, ту вещь, чсто наш мир довольно пуст? Ни зданий, ни предметов, вообще ничего!"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=75166894]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "И какой олух захочет играть в игру, где в мире нет никого, кроме тебя любимого? Надо это исправить"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase3" unique_id=1690535127]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Подумай Стенли, каким бы ты хотел видеть этот мир?"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase4" type="Control" parent="CanvasLayer/Dialogs" unique_id=1599477361]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase4" unique_id=722490819]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Замечательный выбор! Ноо, кажется чего-то не хватает..."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase4" unique_id=990119337]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Хмм... Ну конечно же Стенли, освещение!"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase4" unique_id=1998836042]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Получится ли человеку полнощенно погрузится в игру, если его все время будет преследовать этот дурацкий, тусклый серый свет? Конечно же нет!"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel5" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase4" unique_id=534777431]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Давай стенли, подумай, какое освещение должно быть у нашей игры?"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase5" type="Control" parent="CanvasLayer/Dialogs" unique_id=369764541]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase5" unique_id=667537339]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Посмотри, как сочитается игровое окружение и освещение, неплохо, да?"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase5" unique_id=1277379871]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Но мы что-то сильно зациклилиси на визуале, а ведь игра - это не только красивый вид, это еще действия, сражения, сюжет и многое другое"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase5" unique_id=1449325970]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Но тебе, Стенли, все-таки до таких вещей еще идти и идти. Так что предлагаю долго не думать, и сделать самое главное - врагах"
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel5" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase5" unique_id=115835821]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Давай, создай самого простого врага, который будет атаковать игрока."
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase6" type="Control" parent="CanvasLayer/Dialogs" unique_id=1609100686]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase6" unique_id=1663572758]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Отлично, враг преследует игрока! Но, пока что атаки нет, так как мы еще даже не добавили механику здоровья."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase6" unique_id=1334264208]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Так давай же добавим здоровье и интерфейс для него!"
visible_characters = 0
visible_ratio = 0.0

[node name="DialogPhase7" type="Control" parent="CanvasLayer/Dialogs" unique_id=956487368]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase7" unique_id=725931699]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Здоровье есть! Но все еще осталась одна проблема."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase7" unique_id=864280383]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Представь, что игрок твоей игры захочет отойти. Например, покушать поспать, сценарий может быть любой."
visible_characters = 0
visible_ratio = 0.0

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Dialogs/DialogPhase7" unique_id=44268907]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.05
anchor_top = 0.75
anchor_right = 0.95
anchor_bottom = 0.95
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_37okk")
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "Но если игроку это понадобится во время игры в нашу игру, то что ему поможет? Правильно - ничего. Поэтому предлагаю добавить паузы и сохранения."
